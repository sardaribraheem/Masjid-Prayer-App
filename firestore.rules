rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(masjidId) {
      return isSignedIn() &&
        (request.auth.token.email == getMasjidUsername(masjidId) ||
         request.auth.token.email == 'superadmin@masjid-app.com');
    }

    function getMasjidUsername(masjidId) {
      return get(/databases/$(database)/documents/masjids/$(masjidId)).data.username;
    }

    function isAdmin(masjidId) {
      return isSignedIn() && (
        // Check if user is the masjid's admin/imam via custom claims or direct match
        request.auth.token.adminFor == masjidId ||
        request.auth.token.imamFor == masjidId ||
        request.auth.token.email == getMasjidUsername(masjidId)
      );
    }

    // ============ PUBLIC READS ============
    // Anyone (signed in or not) can read masjid listings
    match /masjids/{masjidId} {
      allow read: if true;

      // Only the admin/imam (or super admin) can update this masjid's document
      allow update: if isAdmin(masjidId) || isOwner(masjidId);

      // Only super admin can create/delete masjid documents
      allow create, delete: if request.auth.token.email == 'superadmin@masjid-app.com';

      // ============ SUB-COLLECTION: questions ============
      match /questions/{questionId} {
        // Anyone signed in can read questions
        allow read: if isSignedIn();

        // Only signed-in users can post questions
        allow create: if isSignedIn() && request.resource.data.masjidId == masjidId;

        // Only admin/imam can answer (update answer/isAnswered fields)
        allow update: if isAdmin(masjidId) &&
          // Only allow updating answer and isAnswered fields
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answer', 'isAnswered']);

        // Only admin/imam can delete questions
        allow delete: if isAdmin(masjidId);
      }

      // ============ SUB-COLLECTION: events ============
      match /events/{eventId} {
        // Anyone signed in can read events
        allow read: if isSignedIn();

        // Only admin/imam can create events
        allow create: if isAdmin(masjidId) && request.resource.data.masjidId == masjidId;

        // Only admin/imam can update events
        allow update: if isAdmin(masjidId);

        // Only admin/imam can delete events
        allow delete: if isAdmin(masjidId);
      }
    }

    // ============ CLAIM REQUESTS (Super Admin Only) ============
    match /claimRequests/{claimId} {
      // Only super admin can read claim requests
      allow read: if request.auth.token.email == 'superadmin@masjid-app.com';

      // Any signed-in user can submit a claim request
      allow create: if isSignedIn();

      // Only super admin can update/delete claims
      allow update, delete: if request.auth.token.email == 'superadmin@masjid-app.com';
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}