rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============ HELPER FUNCTIONS ============

    function isSignedIn() {
      return request.auth != null;
    }

    /// Read the masjid document to get its stored admin email.
    function getMasjidAdminEmail(masjidId) {
      return get(/databases/$(database)/documents/masjids/$(masjidId)).data.username;
    }

    /// A user is admin of a masjid if their Firebase Auth email matches the
    /// masjid document's `username` field (which stores the admin email).
    /// Also accepts the super-admin hardcoded email.
    function isAdmin(masjidId) {
      return isSignedIn() && (
        request.auth.token.email == getMasjidAdminEmail(masjidId) ||
        request.auth.token.email == 'superadmin@masjid-app.com'
      );
    }

    // ============ MASJID DOCUMENTS ============
    match /masjids/{masjidId} {
      // Anyone (signed in or not) can read masjid listings
      allow read: if true;

      // Only the admin (email match) or super admin can update a masjid
      allow update: if isAdmin(masjidId);

      // Any signed-in user can create a masjid, but the `username` field
      // (admin email) must match the creator's Firebase Auth email. This
      // prevents impersonation while allowing self-registration.
      allow create: if isSignedIn() &&
        request.resource.data.username == request.auth.token.email;

      // Only super admin can delete masjid documents
      allow delete: if isSignedIn() &&
        request.auth.token.email == 'superadmin@masjid-app.com';

      // ============ SUB-COLLECTION: questions ============
      match /questions/{questionId} {
        // Any signed-in user can read questions for their masjid
        allow read: if isSignedIn();

        // Any signed-in user can create a question (must set correct masjidId)
        allow create: if isSignedIn() &&
          request.resource.data.masjidId == masjidId;

        // Only admin/imam can answer (update answer/isAnswered fields)
        allow update: if isAdmin(masjidId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answer', 'isAnswered']);

        // Only admin/imam can delete questions
        allow delete: if isAdmin(masjidId);
      }

      // ============ SUB-COLLECTION: events ============
      match /events/{eventId} {
        // Any signed-in user can read events
        allow read: if isSignedIn();

        // Only admin can create events
        allow create: if isAdmin(masjidId) &&
          request.resource.data.masjidId == masjidId;

        // Only admin can update events
        allow update: if isAdmin(masjidId);

        // Only admin can delete events
        allow delete: if isAdmin(masjidId);
      }
    }

    // ============ USER DOCUMENTS (Muqtaddi accounts, `latesttodo.md` §2) ============
    // Roles live in `users/{uid}`. A signed-in user can read and manage their
    // OWN document, but can never self-assign elevated roles: registration
    // creates a plain `muqtaddi`, and `role` / `verificationStatus` /
    // `eventPermission` can only be changed by an admin/imam — which the
    // full §9 rule rewrite models. Until that lands, self-update is limited
    // to profile/association fields and role fields are immutable.
    match /users/{userId} {
      // A user reads their own document (hydrates role on login).
      allow read: if isSignedIn() && request.auth.uid == userId;

      // Registration: create your own doc, always starting as a plain
      // `muqtaddi` with no verification and no event permission.
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'muqtaddi' &&
        request.resource.data.verificationStatus == 'none' &&
        request.resource.data.eventPermission == 'none';

      // Self-edit of profile/association fields only; role, verification
      // and event permission must stay identical to the stored document.
      allow update: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.verificationStatus ==
          resource.data.verificationStatus &&
        request.resource.data.eventPermission ==
          resource.data.eventPermission &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['username', 'email', 'masjidId', 'masjidName', 'lastLogin']);
    }

    // ============ CLAIM REQUESTS (Super Admin Only) ============
    match /claimRequests/{claimId} {
      allow read: if isSignedIn() &&
        request.auth.token.email == 'superadmin@masjid-app.com';

      allow create: if isSignedIn();

      allow update, delete: if isSignedIn() &&
        request.auth.token.email == 'superadmin@masjid-app.com';
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
